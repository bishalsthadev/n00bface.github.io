---
---

<section id="contact" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-foreground mb-2">
      <span class="text-accent">06.</span> Get In Touch
    </h2>
    <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Terminal Contact -->
      <div class="bg-[#0d1117] border border-border shadow-2xl rounded-xl overflow-hidden shadow-black/50">
        <div class="flex items-center gap-2 px-4 py-3 bg-[#161b22] border-b border-border">
          <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
          <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
          <span class="ml-2 text-xs text-muted font-mono">contact.sh</span>
        </div>
        <div class="p-6 font-mono text-sm leading-relaxed overflow-x-auto w-full">
          <div class="mb-4">
            <p class="text-accent whitespace-nowrap">$ <span class="text-foreground">whoami</span></p>
            <p class="text-muted mt-1">Bishal Shrestha</p>
          </div>
          
          <div class="mb-4">
            <p class="text-accent whitespace-nowrap">$ <span class="text-foreground">cat contact_info.json</span></p>
            <div class="text-muted mt-1 text-xs sm:text-sm whitespace-pre">{`{
  "email": "bishalkumar45657@gmail.com",
  "location": "Kathmandu, Nepal",
  "availability": "Open to opportunities"
}`}</div>
          </div>

          <div class="mb-4">
            <p class="text-accent whitespace-nowrap">$ <span class="text-foreground">./send_message.sh</span></p>
            <p class="text-[#27c93f] mt-1">✓ Ready to connect!</p>
          </div>

          <div>
            <p class="text-accent">$ <span class="terminal-cursor">_</span></p>
          </div>
        </div>
      </div>

      <!-- Contact Info & Links -->
      <div class="flex flex-col justify-center">
        <p class="text-muted mb-8 max-w-md text-lg leading-relaxed">
          I'm currently looking for new opportunities. Whether you have a question, 
          want to collaborate, or just want to say hi, feel free to reach out!
        </p>

        <div class="space-y-4">
          <button 
            id="copy-email-btn"
            class="w-full text-left flex items-center gap-4 p-4 bg-card/80 backdrop-blur-md border border-border rounded-xl hover:border-accent shadow-sm hover:-translate-y-1 transition-all duration-300 group relative cursor-pointer"
          >
            <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center group-hover:bg-accent/20 transition-colors">
              <svg class="w-6 h-6 text-accent block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-foreground font-medium flex items-center gap-2">
                Email
                <span id="copy-email-toast" class="opacity-0 translate-y-1 text-xs font-semibold text-[#27c93f] transition-all duration-300">Copied!</span>
              </p>
              <p class="text-muted text-sm transition-colors group-hover:text-foreground">bishalkumar45657@gmail.com</p>
            </div>
          </button>

          <a 
            href="https://linkedin.com/in/bishal-shrestha-404553274"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 bg-card/80 backdrop-blur-md border border-border rounded-xl hover:border-accent-secondary shadow-sm hover:-translate-y-1 transition-all duration-300 group"
          >
            <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center group-hover:bg-accent-secondary/20 transition-colors">
              <svg class="w-6 h-6 text-accent-secondary block" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <p class="text-foreground font-medium">LinkedIn</p>
              <p class="text-muted text-sm transition-colors group-hover:text-foreground">linkedin.com/in/bishal-shrestha</p>
            </div>
          </a>

          <a 
            href="https://github.com/bishalsthadev"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 bg-card/80 backdrop-blur-md border border-border rounded-xl hover:border-accent shadow-sm hover:-translate-y-1 transition-all duration-300 group"
          >
            <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center group-hover:bg-accent/20 transition-colors">
              <svg class="w-6 h-6 text-accent block" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <p class="text-foreground font-medium">GitHub</p>
              <p class="text-muted text-sm transition-colors group-hover:text-foreground">github.com/bishalsthadev</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const toast = document.getElementById('copy-email-toast');
  
  if (copyBtn && toast) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('bishalkumar45657@gmail.com');
        toast.classList.remove('opacity-0', 'translate-y-1');
        
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-1');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy email: ', err);
      }
    });
  }
</script>
