---
// Experience data
const experiences = [
  {
    company: "Codewing Solutions",
    location: "Kathmandu, Nepal",
    role: "Backend Developer & WordPress Plugin Developer",
    period: "May 2021 – Present",
    achievements: [
      "Led feature development for WP Delicious (4,000+ active installs) and contributed significantly to WP Travel Engine (20,000+ active installs)",
      "Engineered and maintained integrations for 70+ diverse global payment gateways (including Stripe, PayPal, Square, Flutterwave, and PesaPal), ensuring secure cross-border transactions",
      "Spearheaded AI integration using ChatGPT and TogetherAI APIs to automate recipe generation and image creation",
      "Engineered complex features including partial/installment payments, advanced itinerary builder, form editor, and Gutenberg block components",
      "Contributing to PayLexer, a multi-gateway payment SaaS platform built on NestJS, NextJS, and PostgreSQL with CI/CD",
      "Coordinated plugin releases, maintained documentation standards, and collaborated across teams on feature scoping and QA",
    ],
  },
];
---

<section id="experience" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="prompt mb-3">
      <span class="prompt-user">bishal@portfolio</span><span class="prompt-sym">:</span><span class="prompt-path">~/experience</span><span class="prompt-sym">$</span> cat *.log
    </p>
    <h2 class="text-3xl font-bold text-foreground mb-2">Experience</h2>
    <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

    <div class="relative">
      {experiences.map((exp) => (
        <div class="relative pl-8 pb-12 last:pb-0 timeline-line">
          <div class="absolute left-0 top-0 w-3 h-3 bg-accent rounded-full transform -translate-x-[5px] mt-2 ring-4 ring-background"></div>
          
          <div class="bg-card/80 backdrop-blur-md border border-border rounded-xl p-6 ml-4 shadow-sm hover:-translate-y-1 transition-transform duration-300">
            <div class="flex flex-col mb-4">
              <h3 class="text-xl font-semibold text-foreground">{exp.role}</h3>
              <div class="flex flex-wrap items-center gap-3 mt-1">
                <p class="text-accent font-medium">{exp.company}</p>
                <div class="hidden sm:block w-1 h-1 rounded-full bg-muted"></div>
                <span class="inline-flex items-center px-2 py-0.5 bg-accent/10 text-accent text-xs font-semibold rounded-full">
                  {exp.period}
                </span>
              </div>
            </div>
            
            <p class="text-muted text-sm mb-4 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {exp.location}
            </p>

            <ul class="space-y-3">
              {exp.achievements.map((achievement) => (
                <li class="flex items-start gap-3 text-muted">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="leading-relaxed text-sm lg:text-base">{achievement}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
