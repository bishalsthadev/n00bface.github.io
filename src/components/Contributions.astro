---
// Generate contribution data for the last year
const today = new Date();
const weeks: { days: { date: string; count: number }[] }[] = [];

for (let i = 52; i >= 0; i--) {
  const weekDays = [];
  for (let j = 0; j < 7; j++) {
    const date = new Date(today);
    date.setDate(date.getDate() - (i * 7 + (6 - j)));
    // Generate random contribution counts (higher for recent dates)
    const recencyFactor = 1 - (i / 52);
    const count = Math.floor(Math.random() * 10 * recencyFactor + Math.random() * 5);
    weekDays.push({
      date: date.toISOString().split('T')[0],
      count,
    });
  }
  weeks.push({ days: weekDays });
}

function getColorClass(count: number): string {
  if (count === 0) return 'bg-[#161b22]';
  if (count <= 3) return 'bg-[#0e4429]';
  if (count <= 6) return 'bg-[#006d32]';
  if (count <= 9) return 'bg-[#26a641]';
  return 'bg-[#39d353]';
}

const monthLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---

<section id="contributions" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-[#ededed] mb-2">
      <span class="text-[#7c3aed]">04.</span> Contributions
    </h2>
    <div class="w-24 h-1 bg-gradient-to-r from-[#7c3aed] to-[#2563eb] mb-8"></div>

    <div class="bg-[#18181b] border border-[#27272a] rounded-xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-[#ededed]">Contribution Activity</h3>
        <a 
          href="https://github.com/bishalsthadev" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-[#7c3aed] hover:text-[#7c3aed]/80 text-sm flex items-center gap-1"
        >
          View on GitHub
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Month labels -->
      <div class="flex mb-2 ml-10">
        {weeks.filter((_, i) => i % 4 === 0).map((_, i) => (
          <div class="flex-1 text-xs text-[#a1a1aa] text-center">
            {monthLabels[i % 12]}
          </div>
        ))}
      </div>

      <!-- Contribution graph -->
      <div class="flex gap-1 overflow-x-auto pb-2">
        {weeks.map((week, weekIndex) => (
          <div class="flex flex-col gap-1 flex-shrink-0">
            {week.days.map((day, dayIndex) => (
              <div
                class={`w-3 h-3 rounded-sm contrib-cell ${getColorClass(day.count)}`}
                title={`${day.count} contributions on ${day.date}`}
              ></div>
            ))}
          </div>
        ))}
      </div>

      <!-- Legend -->
      <div class="flex items-center justify-end gap-2 mt-4 text-xs text-[#a1a1aa]">
        <span>Less</span>
        <div class="w-3 h-3 rounded-sm bg-[#161b22]"></div>
        <div class="w-3 h-3 rounded-sm bg-[#0e4429]"></div>
        <div class="w-3 h-3 rounded-sm bg-[#006d32]"></div>
        <div class="w-3 h-3 rounded-sm bg-[#26a641]"></div>
        <div class="w-3 h-3 rounded-sm bg-[#39d353]"></div>
        <span>More</span>
      </div>
    </div>
  </div>
</section>
