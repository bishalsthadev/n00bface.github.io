---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

{posts.length > 0 && (
  <section id="writing" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-2 gap-4">
        <h2 class="text-3xl font-bold text-foreground">
          <span class="text-accent">05.</span> Writing
        </h2>
        <a href="/blog" class="text-sm text-accent hover:text-accent-secondary transition-colors whitespace-nowrap">
          View all posts →
        </a>
      </div>
      <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex flex-col bg-card/80 backdrop-blur-md border border-border rounded-xl p-6 hover:border-accent transition-all duration-300 shadow-sm hover:shadow-lg"
          >
            <time datetime={post.data.pubDate.toISOString()} class="text-xs text-muted font-mono mb-3">
              {dateFmt.format(post.data.pubDate)}
            </time>
            <h3 class="text-lg font-semibold text-foreground mb-2 group-hover:text-accent transition-colors">
              {post.data.title}
            </h3>
            <p class="text-muted text-sm leading-relaxed mb-4 flex-grow">{post.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="px-2.5 py-1 bg-border/40 border border-border/60 text-muted text-xs rounded-full font-mono">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
