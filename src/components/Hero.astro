---

<section id="about" class="min-h-screen flex items-center justify-center pt-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-accent font-mono text-sm mb-4">Hi, my name is</p>
    
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-foreground mb-4">
      Bishal Shrestha.
    </h1>
    
    <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-muted mb-6">
      I build things for the web.
    </h2>
    
    <p class="text-muted text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
      Backend-focused developer with 
      <span class="text-accent font-semibold">4+ years</span> of experience building 
      commercial WordPress plugins active on 
      <span class="text-accent-secondary font-semibold">20,000+ sites</span> worldwide.
    </p>

    <div class="terminal-window inline-block border border-border rounded-lg mb-8 text-left w-full max-w-lg md:max-w-xl mx-auto overflow-hidden shadow-2xl shadow-black/40">
      <div class="flex items-center gap-2 px-4 py-2.5 bg-[#161b22] border-b border-border">
        <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
        <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
        <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
        <span class="ml-2 text-xs text-muted font-mono">whoami.sh</span>
      </div>
      <div class="p-5">
        <p class="font-mono text-sm">
          <span class="text-accent">$</span>
          <span class="text-foreground ml-2">whoami</span>
        </p>
        <p class="font-mono text-sm text-muted mt-2 min-h-[6rem]">
          <span id="typing-output" class="whitespace-pre-wrap"></span><span class="terminal-cursor text-accent">_</span>
        </p>
      </div>
    </div>

    <script>
      const roles = [
        'Backend Developer',
        'WordPress Plugin Expert',
        'Payment Gateway Integration',
        'AI API Integration',
        'Serverless / Edge Apps',
      ];
      const output = document.getElementById('typing-output');
      if (output) {
        let roleIndex = 0;
        let charIndex = 0;
        let lines: string[] = [];
        let isDeleting = false;

        function tick() {
          const current = roles[roleIndex];
          if (!isDeleting) {
            charIndex++;
            const displayed = [...lines, '> ' + current.slice(0, charIndex)].join('\n');
            output.textContent = displayed;
            if (charIndex === current.length) {
              lines.push('> ' + current);
              charIndex = 0;
              roleIndex++;
              if (roleIndex < roles.length) {
                setTimeout(tick, 400);
              }
              return;
            }
            setTimeout(tick, 55);
          }
        }
        setTimeout(tick, 600);
      }
    </script>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="#projects" class="btn-primary">
        Check out my work
      </a>
      <a href="#contact" class="btn-secondary">
        Get in touch
      </a>
    </div>

