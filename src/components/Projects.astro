---
// Projects data
const projects = [
  {
    name: "NEPSE Alert",
    logo: null,
    description: "Personal Nepal Stock Exchange assistant — price/threshold alerts, portfolio tracking, market news, and a technical screener (SMA/EMA/RSI/MACD), delivered Telegram-first with a web dashboard. Runs entirely on Cloudflare Workers.",
    type: "Full-Stack App",
    technologies: ["TypeScript", "Cloudflare Workers", "D1", "KV", "grammY"],
    link: "https://stock.bishalstha.info.np",
    featured: true,
  },
  {
    name: "WP Travel Engine",
    logo: "/logos/wp-travel-engine.png",
    description: "Full-featured travel booking plugin with itinerary management, availability scheduling, and multi-gateway payment support.",
    type: "WordPress Plugin",
    stats: "20,000+ active installs",
    technologies: ["PHP", "React", "Gutenberg", "REST API"],
    link: "https://wordpress.org/plugins/wp-travel-engine",
    featured: true,
  },
  {
    name: "WP Delicious (Delicious Recipes)",
    logo: "/logos/wp-delicious.jpg",
    description: "Recipe management plugin with AI recipe generation, nutrition tracking, meal planning, and Chicory grocery integration.",
    type: "WordPress Plugin",
    stats: "4,000+ active installs",
    technologies: ["PHP", "React", "AI APIs", "Gutenberg"],
    link: "https://wordpress.org/plugins/delicious-recipes",
    featured: true,
  },
  {
    name: "PayLexer",
    logo: "/logos/paylexer-mark.png",
    description: "Middleware connecting WordPress plugins to 27+ payment gateways — including Stripe, PayPal, Paystack, and Xendit — with no-code setup, a unified dashboard, and integrations for WooCommerce, WP Travel Engine, and Easy Digital Downloads.",
    type: "SaaS Platform",
    technologies: ["NestJS", "NextJS", "PostgreSQL", "CI/CD"],
    link: "https://paylexer.com",
    featured: true,
  },
  {
    name: "NGS Congress – Registration Add-ons",
    logo: null,
    description: "Custom WooCommerce extension for an academic congress: category-driven delegate registration fields resolved server-side, document uploads with an admin approval workflow, HPOS-safe order meta, CSV export, and a custom-post-type abstract review queue with automated author emails.",
    type: "WordPress Plugin",
    stats: "Private client plugin",
    technologies: ["PHP", "WooCommerce", "OOP", "Custom Post Types"],
    link: null,
    featured: false,
  },
  {
    name: "WP Travel Engine Add-ons",
    logo: "/logos/wp-travel-engine.png",
    description: "Premium add-on suite for WP Travel Engine — Paddle payment gateway, partial payments, trip extras, and a React JS admin UI.",
    type: "WordPress Plugin",
    stats: "Premium add-on suite",
    technologies: ["PHP", "React", "REST API"],
    link: "https://wptravelengine.com/plugins/",
    featured: false,
  },
  {
    name: "Delisho – Recipe Widgets & Blocks",
    logo: "/logos/delisho.png",
    description: "Gutenberg block library and widget pack extending WP Delicious with customizable recipe display components.",
    type: "WordPress Plugin",
    technologies: ["PHP", "Gutenberg", "React"],
    link: "https://wordpress.org/plugins/dr-widgets-blocks",
    featured: false,
  },
];

const featuredProjects = projects.filter(p => p.featured);
const otherProjects = projects.filter(p => !p.featured);
---

<section id="projects" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="prompt mb-3">
      <span class="prompt-user">bishal@portfolio</span><span class="prompt-sym">:</span><span class="prompt-path">~/projects</span><span class="prompt-sym">$</span> ls -la
    </p>
    <h2 class="text-3xl font-bold text-foreground mb-2">Projects</h2>
    <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

    <!-- Featured Projects -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
      {featuredProjects.map((project) => (
        <div class="group bg-card/80 backdrop-blur-md border border-border rounded-xl p-6 hover:border-accent transition-all duration-300 shadow-sm hover:shadow-lg">
          <div class="flex items-start justify-between mb-4">
            {project.logo ? (
              <div class="w-12 h-12 rounded-lg overflow-hidden bg-white/5 border border-border/60 flex items-center justify-center shadow-lg shadow-black/20">
                <img
                  src={project.logo}
                  alt={`${project.name} logo`}
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain"
                />
              </div>
            ) : (
              <div class="w-12 h-12 bg-gradient-to-br from-accent to-accent-secondary rounded-lg flex items-center justify-center shadow-lg shadow-accent/20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
              </div>
            )}
            {project.link && (
              <a 
                href={project.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-muted hover:text-accent transition-colors"
                aria-label={`View ${project.name}`}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>

          <h3 class="text-xl font-semibold text-foreground mb-2 group-hover:text-accent transition-colors">
            {project.name}
          </h3>
          
          {project.stats && (
            <div class="inline-flex items-center px-4 py-1.5 bg-accent/15 border border-accent/20 text-accent text-sm font-medium rounded-full mb-4 shadow-[0_0_15px_rgba(124,58,237,0.15)]">
              <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3.5v9.5m0 0l-3.5-3.5M12 13l3.5-3.5" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 16v2.5a2 2 0 002 2h11a2 2 0 002-2V16" />
              </svg>
              {project.stats}
            </div>
          )}

          <p class="text-muted leading-relaxed mb-6">{project.description}</p>

          <div class="flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <span class="px-3 py-1 bg-border/40 border border-border/60 text-muted text-xs rounded-full font-mono">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Other Projects -->
    {otherProjects.length > 0 && (
      <div>
        <h3 class="text-xl font-semibold text-foreground mb-6">Other Projects</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {otherProjects.map((project) => (
            <div class="bg-card/60 backdrop-blur-sm border border-border rounded-xl p-5 hover:border-accent-secondary transition-all duration-300">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-3 min-w-0">
                  {project.logo && (
                    <img
                      src={project.logo}
                      alt={`${project.name} logo`}
                      width="32"
                      height="32"
                      loading="lazy"
                      decoding="async"
                      class="w-8 h-8 rounded-md object-contain bg-white/5 border border-border/60 shrink-0"
                    />
                  )}
                  <h4 class="text-lg font-medium text-foreground group-hover:text-accent-secondary truncate">{project.name}</h4>
                </div>
                {project.link && (
                  <a 
                    href={project.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-muted hover:text-accent-secondary transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>
              <p class="text-muted text-sm leading-relaxed mb-4">{project.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <span class="px-2.5 py-1 bg-border/40 border border-border/60 text-muted text-xs rounded-full font-mono">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
