---
const education = [
  {
    degree: 'Bachelor of Computer Application (BCA)',
    school: 'Danfe College',
    location: 'Kathmandu, Nepal',
    period: 'Nov 2018 – Feb 2024',
  },
];
---

<section id="education" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="prompt mb-3">
      <span class="prompt-user">bishal@portfolio</span><span class="prompt-sym">:</span><span class="prompt-path">~/education</span><span class="prompt-sym">$</span> cat degree.txt
    </p>
    <h2 class="text-3xl font-bold text-foreground mb-2">Education</h2>
    <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

    {education.map((e) => (
      <div class="bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <h3 class="text-lg font-semibold text-foreground">{e.degree}</h3>
            <p class="text-muted text-sm mt-1">{e.school} · {e.location}</p>
          </div>
          <span class="text-muted text-sm font-mono shrink-0">{e.period}</span>
        </div>
      </div>
    ))}
  </div>
</section>
