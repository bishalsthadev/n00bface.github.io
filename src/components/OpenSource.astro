---
// Verified from https://profiles.wordpress.org/rainynewt/ — no synthetic data here.
const releases = ['6.8', '6.9'];

const badges = [
  {
    title: 'WordPress Core Contributor',
    detail: 'Credited on the WordPress 6.8 and 6.9 releases.',
    iconWrap: 'bg-accent/10',
    iconColor: 'text-accent',
  },
  {
    title: 'Plugin Developer',
    detail: 'Maintainer on plugins published to the WordPress.org repository.',
    iconWrap: 'bg-accent-secondary/10',
    iconColor: 'text-accent-secondary',
  },
];

const plugins = [
  { name: 'WP Travel Engine', installs: '20,000+ active installs', href: 'https://wordpress.org/plugins/wp-travel-engine/' },
  { name: 'Delicious Recipes', installs: '4,000+ active installs', href: 'https://wordpress.org/plugins/delicious-recipes/' },
  { name: 'Delisho – Recipe Blocks', installs: 'Gutenberg block library', href: 'https://wordpress.org/plugins/dr-widgets-blocks/' },
];
---

<section id="open-source" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="prompt mb-3">
      <span class="prompt-user">bishal@portfolio</span><span class="prompt-sym">:</span><span class="prompt-path">~/open-source</span><span class="prompt-sym">$</span> cat credits.md
    </p>
    <h2 class="text-3xl font-bold text-foreground mb-2">Open Source</h2>
    <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      {badges.map((b) => (
        <div class="bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
          <div class="flex items-start gap-4">
            <div class={`w-12 h-12 shrink-0 ${b.iconWrap} rounded-lg flex items-center justify-center`}>
              <!-- Official WordPress mark (Dashicons, GPLv2) -->
              <svg class={`w-6 h-6 ${b.iconColor} block`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M20 10c0-5.52-4.48-10-10-10S0 4.48 0 10s4.48 10 10 10 10-4.48 10-10zM10 1.01c4.97 0 8.99 4.02 8.99 8.99s-4.02 8.99-8.99 8.99S1.01 14.97 1.01 10 5.03 1.01 10 1.01zM8.01 14.82L4.96 6.61c.49-.03 1.05-.08 1.05-.08.43-.05.38-1.01-.06-.99 0 0-1.29.1-2.13.1-.15 0-.33 0-.52-.01 1.44-2.17 3.9-3.6 6.7-3.6 2.09 0 3.99.79 5.41 2.09-.6-.08-1.45.35-1.45 1.42 0 .66.38 1.22.79 1.88.31.54.5 1.22.5 2.21 0 1.34-1.27 4.48-1.27 4.48l-2.71-7.5c.48-.03.75-.16.75-.16.43-.05.38-1.1-.05-1.08 0 0-1.3.11-2.14.11-.78 0-2.11-.11-2.11-.11-.43-.02-.48 1.06-.05 1.08l.84.08 1.12 3.04zm6.02 2.15L16.64 10s.67-1.69.39-3.81c.63 1.14.94 2.42.94 3.81 0 2.96-1.56 5.58-3.94 6.97zM2.68 6.77L6.5 17.25c-2.67-1.3-4.47-4.08-4.47-7.25 0-1.16.2-2.23.65-3.23zm7.45 4.53l2.29 6.25c-.75.27-1.57.42-2.42.42-.72 0-1.41-.11-2.06-.3z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-foreground">{b.title}</h3>
              <p class="text-muted text-sm mt-1 leading-relaxed">{b.detail}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <h3 class="text-lg font-semibold text-foreground">Release credits</h3>
        <a
          href="https://profiles.wordpress.org/rainynewt/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:text-accent/80 text-sm flex items-center gap-1 transition-colors"
        >
          Verify on WordPress.org
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="flex flex-wrap gap-2 mb-6">
        {releases.map((r) => (
          <span class="px-4 py-1.5 bg-accent/15 border border-accent/20 text-accent text-sm font-medium rounded-full font-mono">
            WordPress {r}
          </span>
        ))}
      </div>

      <h4 class="text-sm font-semibold text-foreground mb-3">Published plugins</h4>
      <ul class="space-y-2">
        {plugins.map((p) => (
          <li class="flex flex-wrap items-baseline gap-x-2 text-sm">
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground hover:text-accent transition-colors font-medium"
            >
              {p.name}
            </a>
            <span class="text-muted">— {p.installs}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
