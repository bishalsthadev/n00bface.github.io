---
---

<section id="skills" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="prompt mb-3">
      <span class="prompt-user">bishal@portfolio</span><span class="prompt-sym">:</span><span class="prompt-path">~/skills</span><span class="prompt-sym">$</span> ls
    </p>
    <h2 class="text-3xl font-bold text-foreground mb-2">Technical Skills</h2>
    <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- WordPress -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
          <!-- Official WordPress mark (Dashicons, GPLv2) -->
          <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M20 10c0-5.52-4.48-10-10-10S0 4.48 0 10s4.48 10 10 10 10-4.48 10-10zM10 1.01c4.97 0 8.99 4.02 8.99 8.99s-4.02 8.99-8.99 8.99S1.01 14.97 1.01 10 5.03 1.01 10 1.01zM8.01 14.82L4.96 6.61c.49-.03 1.05-.08 1.05-.08.43-.05.38-1.01-.06-.99 0 0-1.29.1-2.13.1-.15 0-.33 0-.52-.01 1.44-2.17 3.9-3.6 6.7-3.6 2.09 0 3.99.79 5.41 2.09-.6-.08-1.45.35-1.45 1.42 0 .66.38 1.22.79 1.88.31.54.5 1.22.5 2.21 0 1.34-1.27 4.48-1.27 4.48l-2.71-7.5c.48-.03.75-.16.75-.16.43-.05.38-1.1-.05-1.08 0 0-1.3.11-2.14.11-.78 0-2.11-.11-2.11-.11-.43-.02-.48 1.06-.05 1.08l.84.08 1.12 3.04zm6.02 2.15L16.64 10s.67-1.69.39-3.81c.63 1.14.94 2.42.94 3.81 0 2.96-1.56 5.58-3.94 6.97zM2.68 6.77L6.5 17.25c-2.67-1.3-4.47-4.08-4.47-7.25 0-1.16.2-2.23.65-3.23zm7.45 4.53l2.29 6.25c-.75.27-1.57.42-2.42.42-.72 0-1.41-.11-2.06-.3z"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">WordPress</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Plugin Development</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Theme Development</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Gutenberg Blocks</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Custom Post Types</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Taxonomies</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Hooks & Filters</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">REST API</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">WP-CLI</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">VIP Standards</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Secure Coding</span>
        </div>
      </div>

      <!-- WooCommerce -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">WooCommerce</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Checkout Customisation</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Cart Validation</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Order Meta (CRUD)</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">HPOS-safe</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Custom Admin Screens</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Payment Gateways</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">CSV Export</span>
        </div>
      </div>

      <!-- Core Languages -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Core Languages</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">PHP</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">JavaScript</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">TypeScript</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">SQL</span>
        </div>
      </div>

      <!-- Frontend -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Frontend</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">React</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">NextJS</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Gutenberg</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">CSS/SCSS</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">HTML5</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">jQuery</span>
        </div>
      </div>

      <!-- Backend -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Backend</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">NestJS</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">WordPress</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">REST APIs</span>
        </div>
      </div>

      <!-- Payments & APIs -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Payments & APIs</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Stripe</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">PayPal</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Paddle</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Square</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">WooCommerce</span>
        </div>
      </div>

      <!-- AI Integration -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">AI Integration</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">ChatGPT API</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">TogetherAI</span>
        </div>
      </div>

      <!-- Tools & DevOps -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Tools & DevOps</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Git</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Docker</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">PostgreSQL</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">CI/CD</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Composer</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Postman</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Cloudflare Workers</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">D1</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">KV</span>
        </div>
      </div>
    </div>
  </div>
</section>
