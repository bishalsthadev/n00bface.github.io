---
---

<section id="skills" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-foreground mb-2">
      <span class="text-accent">01.</span> Technical Skills
    </h2>
    <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-8"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Core Languages -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Core Languages</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">PHP</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">JavaScript</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">TypeScript</span>
        </div>
      </div>

      <!-- Frontend -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Frontend</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">React</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">NextJS</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Gutenberg</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">CSS/SCSS</span>
        </div>
      </div>

      <!-- Backend -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Backend</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">NestJS</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">WordPress</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">REST APIs</span>
        </div>
      </div>

      <!-- Payments & APIs -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Payments & APIs</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Stripe</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">PayPal</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Paddle</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">WooCommerce</span>
        </div>
      </div>

      <!-- AI Integration -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">AI Integration</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">ChatGPT API</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">TogetherAI</span>
        </div>
      </div>

      <!-- Tools & DevOps -->
      <div class="skill-card bg-card/80 backdrop-blur-md border border-border rounded-xl p-6">
        <div class="w-12 h-12 bg-accent-secondary/10 rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-foreground mb-3">Tools & DevOps</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Git</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">Docker</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">PostgreSQL</span>
          <span class="px-3 py-1 bg-border/50 text-muted text-sm rounded-full">CI/CD</span>
        </div>
      </div>
    </div>
  </div>
</section>
