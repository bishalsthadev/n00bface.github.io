---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title="Blog - Bishal Shrestha"
  description="Writing on backend engineering, serverless architecture, payment systems, and the projects I build."
>
  <Navbar />
  <main class="pt-28 pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-foreground mb-2">Writing</h1>
      <div class="w-24 h-1 bg-gradient-to-r from-accent to-accent-secondary mb-4"></div>
      <p class="text-muted mb-12 leading-relaxed">
        Deep dives and build logs from the things I ship — serverless architecture,
        payment systems, and backend engineering.
      </p>

      {posts.length === 0 ? (
        <p class="text-muted">No posts yet. Check back soon.</p>
      ) : (
        <ul class="space-y-6">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group block bg-card/80 backdrop-blur-md border border-border rounded-xl p-6 hover:border-accent transition-all duration-300 shadow-sm hover:shadow-lg"
              >
                <div class="flex items-center gap-3 text-xs text-muted font-mono mb-3">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFmt.format(post.data.pubDate)}
                  </time>
                  {post.data.tags.length > 0 && <span class="text-border">/</span>}
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="px-2 py-0.5 bg-border/40 border border-border/60 rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <h2 class="text-xl font-semibold text-foreground mb-2 group-hover:text-accent transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-muted text-sm leading-relaxed">{post.data.description}</p>
                <span class="inline-block mt-4 text-sm text-accent font-medium">
                  Read more →
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>

  <footer class="border-t border-border py-8">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/" class="text-sm text-muted hover:text-accent transition-colors">← Back to home</a>
    </div>
  </footer>
</BaseLayout>
